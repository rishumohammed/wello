{
  "name": "wello",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "audit:ci": "npm audit --audit-level=high",
    "security:check": "npm audit && npm --prefix backend audit && npm --prefix frontend audit",
    "docs:generate": "node --experimental-strip-types scripts/generate-docs.mjs",
    "docs:check": "node --experimental-strip-types scripts/generate-docs.mjs --check",
    "license:check": "node scripts/check_licenses.mjs",
    "test:runner": "node scripts/run_test_runner.mjs",
    "test:metrics-fixtures": "node --experimental-strip-types backend/tests/test_metrics_fixture_suite.mjs",
    "test:env-safety": "node --experimental-strip-types backend/tests/test_env_validation_and_startup_safety.mjs",
    "test:compose-security": "node backend/tests/test_compose_and_network_security.mjs",
    "test:backup-restore": "node backend/tests/test_backup_and_restore_drills.mjs",
    "test:migrations": "node scripts/verify_migrations.mjs",
    "test:hardening": "node backend/tests/test_route_guard_hardening.mjs",
    "test:global-sync": "node backend/tests/test_global_correctness_and_sync.mjs",
    "test:security": "node backend/tests/test_production_hardening.mjs",
    "test:load": "node backend/tests/load_test_autocannon.mjs",
    "test:requirements": "node backend/tests/test_comprehensive_requirements.mjs",
    "test:global": "node scripts/check_global_assumptions.mjs",
    "test:audit": "node backend/tests/test_security_audit_hardening.mjs",
    "test:financial": "node backend/tests/test_audit_chain_and_financial_safety.mjs",
    "test:unit": "node backend/tests/test_unit_suites.mjs",
    "test:e2e": "node backend/tests/test_e2e_playwright_flows.mjs"
  },
  "dependencies": {
    "@pinia/nuxt": "0.5.4",
    "@vueuse/core": "11.0.0",
    "@vueuse/nuxt": "11.0.0",
    "dayjs": "1.11.13",
    "mysql2": "3.11.0",
    "nuxt": "3.13.0",
    "pinia": "2.2.0",
    "vue": "3.4.0",
    "vue-router": "4.4.0"
  },
  "devDependencies": {
    "@types/node": "20.12.0",
    "typescript": "5.5.0",
    "vue-tsc": "2.0.0"
  }
}
