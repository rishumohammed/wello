# ==============================================================================
# Wello Environment Configuration (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000

# Database Configuration (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=wello_user
DB_PASSWORD=wello_secure_password
DB_NAME=wello
DB_POOL_MIN=2
DB_POOL_MAX=20

# Regional & Currency Settings (Region-Agnostic Defaults)
# Examples: USD ($), EUR (€), GBP (£), INR (₹), CAD ($), AUD ($)
CURRENCY_SYMBOL=$
DEFAULT_COUNTRY=US
DEFAULT_TIMEZONE=UTC

# Public URLs & CORS Allowlist
FRONTEND_URL=http://localhost:3000
BACKEND_API_URL=http://localhost:3001/api
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80,http://127.0.0.1:3000

# Redis Cache & Shared Rate Limiter (Optional — Falls back to MySQL)
REDIS_URL=redis://127.0.0.1:6379

# Email Delivery via Resend (Optional in Dev — Sandbox fallback active)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=Wello

# Storage Driver for Logo Uploads (local or s3)
STORAGE_DRIVER=local
# If STORAGE_DRIVER=s3:
S3_BUCKET=wello-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://assets.wello.app

# Error Tracking via Sentry (Optional)
SENTRY_DSN=
